# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/nova_fashion

# JWT Authentication
JWT_SECRET=supersecretjwtkey_novafashion_secure_2026
JWT_EXPIRES_IN=7d

# Allowed Frontend URLs for CORS (comma separated or *)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:5173

# Payment Gateway Configuration (bKash / Nagad)
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v2.0-beta
BKASH_APP_KEY=sandbox_app_key
BKASH_APP_SECRET=sandbox_app_secret
BKASH_USERNAME=sandbox_username
BKASH_PASSWORD=sandbox_password

NAGAD_BASE_URL=http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0/api/dfs
NAGAD_MERCHANT_ID=sandbox_merchant_id
NAGAD_PUBLIC_KEY=sandbox_public_key
NAGAD_PRIVATE_KEY=sandbox_private_key
